<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.github.trilhalog</groupId>
    <artifactId>trilha-log</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>trilha-log</name>
    <description>Logging estruturado (Log4j2 + JSON) com correlacao de requisicao, AOP de entrada/saida/excecao e mascaramento de dados sensiveis, como starter Spring Boot</description>
    <url>https://github.com/trilha-log/trilha-log</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/trilha-log/trilha-log/blob/main/LICENSE</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/trilha-log/trilha-log</url>
        <connection>scm:git:https://github.com/trilha-log/trilha-log.git</connection>
        <developerConnection>scm:git:https://github.com/trilha-log/trilha-log.git</developerConnection>
    </scm>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!-- Publicado no GitHub Packages (Maven registry da org trilha-log) para outros projetos
         conseguirem resolver a dependência sem precisar de ~/.m2 local — CI e Docker build de
         quem consome não têm acesso ao Maven local de ninguém. -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — trilha-log</name>
            <url>https://maven.pkg.github.com/trilha-log/trilha-log</url>
        </repository>
    </distributionManagement>

    <dependencies>
        <!-- Core Spring Boot. Exclui spring-boot-starter-logging (Logback): esta lib traz o
             motor de logging (Log4j2) e as duas bindings SLF4J juntas geram provider
             ambiguo no classpath (ver spring-boot-starter-log4j2 mais abaixo). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- AOP: @LogExecution. spring-boot-starter-aop foi renomeado para
             spring-boot-starter-aspectj no Spring Boot 4.0. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Web: RequestCorrelationFilter (sem puxar spring-boot-starter-web inteiro) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Motor de logging: Log4j2 + layout JSON estruturado -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-layout-template-json</artifactId>
        </dependency>

        <!-- JPA opcional: usado so para detectar @Entity via capability detection isolada -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Micrometer Tracing opcional: correlacao de spans (traceId/spanId) com OpenTelemetry ou Brave -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testes. Mesma exclusao: spring-boot-starter-test traz spring-boot-starter-logging
             transitivamente, o que reintroduziria Logback so no classpath de teste. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
